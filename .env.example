# 이 파일을 .env로 복사한 뒤 실제 값을 넣어주세요. (.env는 GitHub에 올라가지 않습니다)

# 서버 포트 (기본 3030)
PORT=3030

# 카카오톡 메시지 발송용 (Kakao Developers에서 발급)
KAKAO_REST_API_KEY=REPLACE_WITH_YOUR_KEY
KAKAO_ADMIN_KEY=
KAKAO_CLIENT_SECRET=
# KAKAO_REDIRECT_URI=http://localhost:3030/auth/kakao/callback

# 후속지도 등급 기준 화면 비밀번호
TIER_PASSWORD=
# 비밀번호를 재설정할 수 있는 선생님 이름 (쉼표로 구분)
ADMIN_NAMES=
